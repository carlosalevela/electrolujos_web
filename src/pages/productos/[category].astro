---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import CatalogSidebar from "../../components/CatalogSidebar.astro";
import CatalogMobileNav from "../../components/CatalogMobileNav.astro";
import ProductFilterGrid from "../../components/ProductFilterGrid.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildSidebar } from "../../lib/catalog";
import { categoryTitle, categoryDescription, categoryIntro } from "../../lib/seo";

const labels: Record<string, string> = {
	"bombilleria-led": "Bombillería LED",
	"bombilleria-halogena": "Bombillería Halógena",
};

export async function getStaticPaths() {
	const allProducts = await getCollection("products");
	const ids = ["bombilleria-led", "bombilleria-halogena"];
	return ids.filter((id) => allProducts.some((p) => p.data.category === id)).map((id) => ({ params: { category: id } }));
}

const allProducts = await getCollection("products");
const activeCategory = Astro.params.category as string;
const activeCategoryLabel = labels[activeCategory] ?? "";
const products = allProducts.filter((p) => p.data.category === activeCategory);
const sections = buildSidebar(allProducts, activeCategory);
---

<Layout
	title={categoryTitle(activeCategoryLabel)}
	description={categoryDescription(activeCategoryLabel)}
>
	<Header />
	<main class="bg-carbon px-5 py-16 md:px-margin-desktop">
		<div class="mx-auto max-w-6xl">
			<Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Productos", href: "/productos/" }, { label: activeCategoryLabel }]} />
			<div class="bezel-top mb-12 pt-4">
				<h1 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
					{activeCategoryLabel}
				</h1>
				<p class="mt-2 font-mono text-xs uppercase tracking-widest text-cream-dim">
					Marcas y referencias disponibles en tienda
				</p>
				<p class="mt-4 max-w-2xl font-body text-cream-dim">
					{categoryIntro(activeCategoryLabel, "bombilleria")}
				</p>
			</div>

			<CatalogMobileNav sections={sections} />

			<div class="grid gap-gutter md:grid-cols-[220px_1fr]">
				<CatalogSidebar sections={sections} />
				<div>
					<ProductFilterGrid products={products} />
				</div>
			</div>
		</div>
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
