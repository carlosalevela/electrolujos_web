---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import WhatsAppFloat from "../../../components/WhatsAppFloat.astro";
import CatalogSidebar from "../../../components/CatalogSidebar.astro";
import CatalogMobileNav from "../../../components/CatalogMobileNav.astro";
import ProductFilterGrid from "../../../components/ProductFilterGrid.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { buildSidebar } from "../../../lib/catalog";
import { categoryTitle, categoryDescription, categoryIntro } from "../../../lib/seo";

const labels: Record<string, string> = {
	tapetes: "Tapetes",
	tejas: "Tejas",
	"seguros-espejo": "Seguros de Espejo",
	cornetas: "Cornetas",
	radios: "Radios",
	alarmas: "Alarmas",
	silicona: "Silicona",
	cera: "Cera",
	aromatizantes: "Aromatizantes",
	llaveros: "Llaveros",
	"kit-carretera": "Kit de carretera",
	"soporte-celular": "Soporte celular",
	"queso-taxi": "Queso taxi",
	"cargador-celular": "Cargador celular",
};

export async function getStaticPaths() {
	const allProducts = await getCollection("products");
	const ids = [
		"tapetes",
		"tejas",
		"seguros-espejo",
		"cornetas",
		"radios",
		"alarmas",
		"silicona",
		"cera",
		"aromatizantes",
		"llaveros",
		"kit-carretera",
		"soporte-celular",
		"queso-taxi",
		"cargador-celular",
	];
	return ids
		.filter((id) => allProducts.some((p) => p.data.category === "accesorios" && p.data.productType === id))
		.map((id) => ({ params: { subcategory: id } }));
}

const allProducts = await getCollection("products");
const activeSubcategory = Astro.params.subcategory as string;
const activeSubcategoryLabel = labels[activeSubcategory] ?? "";
const products = allProducts.filter(
	(p) => p.data.category === "accesorios" && p.data.productType === activeSubcategory
);
const sections = buildSidebar(allProducts, "accesorios", activeSubcategory);
---

<Layout
	title={categoryTitle(activeSubcategoryLabel)}
	description={categoryDescription(activeSubcategoryLabel)}
>
	<Header />
	<main class="bg-carbon px-5 py-16 md:px-margin-desktop">
		<div class="mx-auto max-w-6xl">
			<Breadcrumbs
				items={[
					{ label: "Inicio", href: "/" },
					{ label: "Productos", href: "/productos" },
					{ label: "Accesorios", href: "/productos/accesorios" },
					{ label: activeSubcategoryLabel },
				]}
			/>
			<div class="bezel-top mb-12 pt-4">
				<h1 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
					Accesorios · {activeSubcategoryLabel}
				</h1>
				<p class="mt-2 font-mono text-xs uppercase tracking-widest text-cream-dim">
					Marcas y referencias disponibles en tienda
				</p>
				<p class="mt-4 max-w-2xl font-body text-cream-dim">
					{categoryIntro(activeSubcategoryLabel, "accesorios")}
				</p>
			</div>

			<CatalogMobileNav sections={sections} />

			<div class="grid gap-gutter md:grid-cols-[220px_1fr]">
				<CatalogSidebar sections={sections} />
				<div>
					<ProductFilterGrid products={products} />
				</div>
			</div>
		</div>
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
