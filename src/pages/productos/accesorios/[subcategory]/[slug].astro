---
import { getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import WhatsAppFloat from "../../../../components/WhatsAppFloat.astro";
import ProductDetail from "../../../../components/ProductDetail.astro";
import { productTitle, productDescription } from "../../../../lib/seo";

const labels: Record<string, string> = {
	tapetes: "Tapetes",
	tejas: "Tejas",
	"seguros-espejo": "Seguros de Espejo",
	cornetas: "Cornetas",
	radios: "Radios",
	alarmas: "Alarmas",
	silicona: "Silicona",
	cera: "Cera",
	aromatizantes: "Aromatizantes",
	llaveros: "Llaveros",
	"kit-carretera": "Kit de carretera",
	"soporte-celular": "Soporte celular",
	"queso-taxi": "Queso taxi",
	"cargador-celular": "Cargador celular",
};

export async function getStaticPaths() {
	const allProducts = await getCollection("products");
	return allProducts
		.filter((p) => p.data.category === "accesorios" && p.data.productType)
		.map((p) => ({
			params: { subcategory: p.data.productType, slug: p.id },
			props: { product: p },
		}));
}

const { product } = Astro.props;
const activeSubcategory = Astro.params.subcategory as string;
const activeSubcategoryLabel = labels[activeSubcategory] ?? "";

const allProducts = await getCollection("products");
const related = allProducts
	.filter(
		(p) =>
			p.data.category === "accesorios" &&
			p.data.productType === activeSubcategory &&
			p.id !== product.id
	)
	.slice(0, 4);
---

<Layout
	title={productTitle(product.data.name)}
	description={productDescription(product.data.description, product.data.brand, product.data.vehicleBrand)}
	image={product.data.image}
>
	<Header />
	<main class="bg-carbon px-5 py-16 md:px-margin-desktop">
		<div class="mx-auto max-w-6xl">
			<ProductDetail
				product={product}
				breadcrumbItems={[
					{ label: "Inicio", href: "/" },
					{ label: "Productos", href: "/productos" },
					{ label: "Accesorios", href: "/productos/accesorios" },
					{ label: activeSubcategoryLabel, href: `/productos/accesorios/${activeSubcategory}` },
					{ label: product.data.name },
				]}
				backHref={`/productos/accesorios/${activeSubcategory}`}
				backLabel={`Volver a ${activeSubcategoryLabel}`}
				related={related}
			/>
		</div>
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
