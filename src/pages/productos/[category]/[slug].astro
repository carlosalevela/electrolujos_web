---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import WhatsAppFloat from "../../../components/WhatsAppFloat.astro";
import ProductDetail from "../../../components/ProductDetail.astro";
import { productTitle, productDescription } from "../../../lib/seo";

const labels: Record<string, string> = {
	"bombilleria-led": "Bombillería LED",
	"bombilleria-halogena": "Bombillería Halógena",
};

export async function getStaticPaths() {
	const allProducts = await getCollection("products");
	const categories = ["bombilleria-led", "bombilleria-halogena"];
	return allProducts
		.filter((p) => categories.includes(p.data.category))
		.map((p) => ({ params: { category: p.data.category, slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const activeCategory = Astro.params.category as string;
const activeCategoryLabel = labels[activeCategory] ?? "";

const allProducts = await getCollection("products");
const related = allProducts
	.filter((p) => p.data.category === activeCategory && p.id !== product.id)
	.slice(0, 4);
---

<Layout
	title={productTitle(product.data.name)}
	description={productDescription(product.data.description, product.data.brand, product.data.vehicleBrand)}
	image={product.data.image}
>
	<Header />
	<main class="bg-carbon px-5 py-16 md:px-margin-desktop">
		<div class="mx-auto max-w-6xl">
			<ProductDetail
				product={product}
				breadcrumbItems={[
					{ label: "Inicio", href: "/" },
					{ label: "Productos", href: "/productos" },
					{ label: activeCategoryLabel, href: `/productos/${activeCategory}` },
					{ label: product.data.name },
				]}
				backHref={`/productos/${activeCategory}`}
				backLabel={`Volver a ${activeCategoryLabel}`}
				related={related}
			/>
		</div>
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
