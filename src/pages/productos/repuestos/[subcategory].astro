---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import WhatsAppFloat from "../../../components/WhatsAppFloat.astro";
import CatalogSidebar from "../../../components/CatalogSidebar.astro";
import ProductFilterGrid from "../../../components/ProductFilterGrid.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { buildSidebar } from "../../../lib/catalog";

const labels: Record<string, string> = {
	espejos: "Espejos",
	plumillas: "Plumillas",
	exploradoras: "Exploradoras",
	farolas: "Farolas",
	stops: "Stops",
};

export async function getStaticPaths() {
	const allProducts = await getCollection("products");
	const ids = ["espejos", "plumillas", "exploradoras", "farolas", "stops"];
	return ids
		.filter((id) => allProducts.some((p) => p.data.category === "repuestos" && p.data.productType === id))
		.map((id) => ({ params: { subcategory: id } }));
}

const allProducts = await getCollection("products");
const activeSubcategory = Astro.params.subcategory as string;
const activeSubcategoryLabel = labels[activeSubcategory] ?? "";
const products = allProducts.filter(
	(p) => p.data.category === "repuestos" && p.data.productType === activeSubcategory
);
const sections = buildSidebar(allProducts, "repuestos", activeSubcategory);
---

<Layout
	title={`${activeSubcategoryLabel} | Repuestos | Electrolujos`}
	description={`Catálogo de ${activeSubcategoryLabel.toLowerCase()} disponibles en Electrolujos, Pasto.`}
>
	<Header />
	<main class="bg-carbon px-5 py-16 md:px-margin-desktop">
		<div class="mx-auto max-w-6xl">
			<Breadcrumbs
				items={[
					{ label: "Inicio", href: "/" },
					{ label: "Productos", href: "/productos" },
					{ label: "Repuestos", href: "/productos/repuestos" },
					{ label: activeSubcategoryLabel },
				]}
			/>
			<div class="bezel-top mb-12 pt-4">
				<h1 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
					Repuestos · {activeSubcategoryLabel}
				</h1>
				<p class="mt-2 font-mono text-xs uppercase tracking-widest text-cream-dim">
					Marcas y referencias disponibles en tienda
				</p>
			</div>

			<div class="grid gap-gutter md:grid-cols-[220px_1fr]">
				<div class="order-2 md:order-1">
					<CatalogSidebar sections={sections} />
				</div>
				<div class="order-1 md:order-2">
					<ProductFilterGrid products={products} />
				</div>
			</div>
		</div>
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
