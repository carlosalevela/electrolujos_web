	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 text-center">
		<span class="font-heading text-lg font-extrabold italic uppercase tracking-tight text-amber"
			>ELECTRO<span class="text-red">LUJOS</span></span
		>

		<nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-xs uppercase tracking-widest text-cream-dim">
			<a href="/productos" class="transition hover:text-amber">Productos</a>
			<a href="/#ubicacion" class="transition hover:text-amber">Ubicación</a>
			<a href="/#contacto" class="transition hover:text-amber">Contacto</a>
			<a href="https://wa.me/573116001851" target="_blank" rel="noopener noreferrer" class="transition hover:text-amber"
				>WhatsApp</a
			>
		</nav>

		<p class="font-mono text-xs uppercase tracking-widest text-cream-dim">
			Calle 15, Pasto, Nariño · 311 600 1851
