---
const categories = [
	{
		name: "Sistema Eléctrico",
		description: "Todo lo relacionado con la instalación y el cableado eléctrico de tu vehículo.",
		items: ["Cableado", "Fusibles", "Bombillería", "Exploradoras", "Instalaciones eléctricas"],
		icon: "M13 2 3 14h7l-1 8 10-12h-7l1-8Z",
		activeSegments: 6,
		link: "/productos/bombilleria-led",
	},
	{
		name: "Repuestos",
		description: "Piezas de reemplazo para mantener tu carro en las mejores condiciones.",
		items: ["Espejos retrovisores", "Tapetes", "Plumillas", "Brazos de plumillas", "Manijas de carro"],
		icon: "M10.5 6a4.5 4.5 0 1 0 4.36 5.6L20 16.74V20h3.26M13.4 11.9 20 5.26",
		activeSegments: 5,
		link: "/productos/repuestos",
	},
	{
		name: "Accesorios",
		description: "Complementos y accesorios para personalizar y mejorar tu vehículo.",
		items: ["Accesorios interiores", "Accesorios exteriores", "Y mucho más"],
		icon: "M12 2 4 6v12l8 4 8-4V6l-8-4Zm0 0v20M4 6l8 4 8-4",
		activeSegments: 4,
	},
];
const totalSegments = 7;
---

<section id="categorias" class="bg-graphite-lowest px-5 py-20 md:px-margin-desktop">
	<div class="mx-auto max-w-6xl">
		<div class="mb-12 flex flex-col items-end justify-between gap-6 md:flex-row">
			<div class="bezel-top pt-4">
				<h2 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
					Hardware disponible
				</h2>
				<p class="font-mono text-xs uppercase tracking-widest text-cream-dim">Elige tu categoría</p>
			</div>
			<div class="mx-8 mb-4 hidden h-px flex-grow bg-graphite-light md:block"></div>
			<span class="font-mono text-xs uppercase tracking-widest text-red">Catalogo_electrolujos</span>
		</div>

		<div class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
			{
				categories.map((category) => (
					<div class="industrial-card group cursor-default border border-graphite-light/60 p-8 transition-colors hover:border-red">
						<div class="mb-6 text-amber">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="h-10 w-10 [filter:drop-shadow(0_0_2px_rgba(255,255,255,0.3))]"
							>
								<path d={category.icon} />
							</svg>
						</div>
						<h3 class="font-heading text-xl font-bold uppercase text-white">{category.name}</h3>
						<p class="mt-2 text-sm text-cream-dim">{category.description}</p>
						<ul class="mt-5 space-y-2">
							{category.items.map((item) => (
								<li class="flex items-center gap-2 font-mono text-xs uppercase tracking-wide text-cream/80">
									<span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-red" />
									{item}
								</li>
							))}
						</ul>
						<div class="mt-6 flex items-center justify-between">
							<span class="segmented-progress">
								{Array.from({ length: totalSegments }).map((_, i) => (
									<span class={i >= category.activeSegments ? "inactive" : ""} />
								))}
							</span>
							<span class="font-mono text-[10px] uppercase tracking-widest text-cream-dim">Variedad</span>
						</div>
						{category.link && (
							<a
								href={category.link}
								class="mt-6 inline-block font-mono text-xs font-semibold uppercase tracking-widest text-amber transition hover:text-white"
							>
								Ver catálogo →
							</a>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
