---
const whatsappNumber = "573116001851";
const whatsappMessage = encodeURIComponent(
	"Hola Electrolujos, quiero información sobre el servicio de instalación."
);

const categories = [
	{
		name: "Sistema Eléctrico",
		description: "Cableado, fusibles y bombillería para el sistema eléctrico de tu vehículo.",
		items: ["Cableado", "Fusibles", "Bombillería", "Exploradoras"],
		icon: "M13 2 3 14h7l-1 8 10-12h-7l1-8Z",
		activeSegments: 6,
		link: "/productos/bombilleria-led",
	},
	{
		name: "Repuestos",
		description: "Espejos, plumillas y piezas de repuesto para mantener tu vehículo en las mejores condiciones.",
		items: ["Espejos retrovisores", "Tapetes", "Plumillas", "Brazos de plumillas", "Manijas de carro"],
		icon: "M10.5 6a4.5 4.5 0 1 0 4.36 5.6L20 16.74V20h3.26M13.4 11.9 20 5.26",
		activeSegments: 5,
		link: "/productos/repuestos",
	},
	{
		name: "Accesorios",
		description: "Todo para personalizar y cuidar tu vehículo, por dentro y por fuera.",
		items: ["Accesorios interiores", "Accesorios exteriores", "Y mucho más"],
		icon: "M12 2 4 6v12l8 4 8-4V6l-8-4Zm0 0v20M4 6l8 4 8-4",
		activeSegments: 4,
		link: "/productos/accesorios",
	},
];
const totalSegments = 7;
---

<section id="categorias" class="bg-graphite-lowest px-5 py-20 md:px-margin-desktop">
	<div class="mx-auto max-w-6xl">
		<div class="mb-12 flex flex-col items-end justify-between gap-6 md:flex-row">
			<div class="bezel-top pt-4">
				<h2 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
					Qué encuentras en Electrolujos
				</h2>
				<p class="font-mono text-xs uppercase tracking-widest text-cream-dim">Elige tu categoría</p>
			</div>
			<div class="mx-8 mb-4 hidden h-px flex-grow bg-graphite-light md:block"></div>
			<span class="font-mono text-xs uppercase tracking-widest text-red">La Bodega de los Espejos</span>
		</div>

		<div class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
			{
				categories.map((category) => (
					<div class="industrial-card group cursor-default border border-graphite-light/60 p-8 transition-colors hover:border-red">
						<div class="mb-6 text-amber">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="h-10 w-10 [filter:drop-shadow(0_0_2px_rgba(255,255,255,0.3))]"
							>
								<path d={category.icon} />
							</svg>
						</div>
						<h3 class="font-heading text-xl font-bold uppercase text-white">{category.name}</h3>
						<p class="mt-2 text-sm text-cream-dim">{category.description}</p>
						<ul class="mt-5 space-y-2">
							{category.items.map((item) => (
								<li class="flex items-center gap-2 font-mono text-xs uppercase tracking-wide text-cream/80">
									<span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-red" />
									{item}
								</li>
							))}
						</ul>
						<div class="mt-6 flex items-center justify-between">
							<span class="segmented-progress">
								{Array.from({ length: totalSegments }).map((_, i) => (
									<span class={i >= category.activeSegments ? "inactive" : ""} />
								))}
							</span>
							<span class="font-mono text-[10px] uppercase tracking-widest text-cream-dim">Variedad</span>
						</div>
						{category.link && (
							<a
								href={category.link}
								class="mt-6 inline-block font-mono text-xs font-semibold uppercase tracking-widest text-amber transition hover:text-white"
							>
								Ver catálogo →
							</a>
						)}
					</div>
				))
			}
		</div>

		<div class="industrial-card mt-6 flex flex-col items-start justify-between gap-6 border border-amber/40 p-8 sm:flex-row sm:items-center">
			<div class="flex items-start gap-4">
				<div class="text-amber">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="h-10 w-10 [filter:drop-shadow(0_0_2px_rgba(255,255,255,0.3))]"
					>
						<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.77Z" />
					</svg>
				</div>
				<div>
					<span
						class="chrome-bezel inline-block bg-amber px-3 py-1 font-mono text-xs font-semibold uppercase tracking-widest text-carbon"
					>
						Servicio
					</span>
					<h3 class="mt-2 font-heading text-xl font-bold uppercase text-white">Servicio de Instalación</h3>
					<p class="mt-2 max-w-md text-sm text-cream-dim">
						Instalamos lo que compras con nosotros: cableado, exploradoras, radios, alarmas y más — hecho por
						nuestro equipo en el local.
					</p>
				</div>
			</div>
			<a
				href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
				target="_blank"
				rel="noopener noreferrer"
				class="chrome-bezel shrink-0 bg-red px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-white transition hover:bg-red-dark"
			>
				Preguntar por instalación
			</a>
		</div>
	</div>
</section>
