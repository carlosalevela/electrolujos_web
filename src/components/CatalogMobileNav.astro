---
import type { SidebarSection } from "../lib/catalog";

interface Props {
	sections: SidebarSection[];
}

const { sections } = Astro.props;
const activeWithSubitems = sections.find((s) => s.active && s.subitems);

const icons: Record<string, string> = {
	"bombilleria-led": "M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.45 1.1 1.2 1.1 2.2h5a2.5 2.5 0 0 1 1.1-2.2A6 6 0 0 0 12 3Z",
	"bombilleria-halogena": "M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.45 1.1 1.2 1.1 2.2h5a2.5 2.5 0 0 1 1.1-2.2A6 6 0 0 0 12 3Z",
	repuestos:
		"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.77Z",
	accesorios: "M12 2 4 6v12l8 4 8-4V6l-8-4Zm0 0v20M4 6l8 4 8-4",
};
---

<div class="mb-6 md:hidden">
	<div class="relative">
		<nav class="no-scrollbar flex gap-2.5 overflow-x-auto py-1 pr-8" aria-label="Categorías">
			{
				sections.map((section) =>
					section.count > 0 ? (
						<a
							href={section.href}
							class={
								section.active
									? "flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full bg-red px-4 py-2.5 font-mono text-xs font-semibold uppercase tracking-widest text-white shadow-[0_0_16px_rgba(177,30,35,0.6)]"
									: "flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-graphite-light bg-graphite px-4 py-2.5 font-mono text-xs uppercase tracking-widest text-cream-dim"
							}
						>
							{icons[section.id] && (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									class="h-3.5 w-3.5 shrink-0"
								>
									<path d={icons[section.id]} />
								</svg>
							)}
							{section.label}
							<span
								class={
									section.active
										? "flex h-4 min-w-4 items-center justify-center rounded-full bg-white/25 px-1 text-[9px]"
										: "flex h-4 min-w-4 items-center justify-center rounded-full bg-graphite-light px-1 text-[9px] text-cream-dim"
								}
							>
								{section.count}
							</span>
						</a>
					) : (
						<span class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-dashed border-graphite-light px-4 py-2.5 font-mono text-xs uppercase tracking-widest text-cream-dim/40">
							{section.label}
						</span>
					)
				)
			}
		</nav>
		<div class="pointer-events-none absolute right-0 top-0 h-full w-8 bg-gradient-to-l from-carbon to-transparent"></div>
	</div>

	{activeWithSubitems?.subitems && (
		<div class="relative mt-2.5">
			<nav class="no-scrollbar flex gap-2 overflow-x-auto py-1 pr-8" aria-label="Subcategorías">
				{
					activeWithSubitems.subitems.map((sub) =>
						sub.count > 0 ? (
							<a
								href={sub.href}
								class={
									sub.active
										? "shrink-0 whitespace-nowrap rounded-full bg-amber px-3.5 py-1.5 font-mono text-[11px] font-semibold uppercase tracking-widest text-carbon"
										: "shrink-0 whitespace-nowrap rounded-full border border-graphite-light/60 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-widest text-cream-dim"
								}
							>
								{sub.label}
							</a>
						) : (
							<span class="shrink-0 whitespace-nowrap rounded-full border border-dashed border-graphite-light/60 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-widest text-cream-dim/30">
								{sub.label}
							</span>
						)
					)
				}
			</nav>
			<div class="pointer-events-none absolute right-0 top-0 h-full w-8 bg-gradient-to-l from-carbon to-transparent"></div>
		</div>
	)}
</div>
