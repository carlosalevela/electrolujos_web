---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: items.map((item, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: item.label,
		item: new URL(item.href ?? Astro.url.pathname, origin).toString(),
	})),
};
---

<nav aria-label="Breadcrumb" class="mb-4">
	<ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-cream-dim">
		{
			items.map((item, i) => (
				<li class="flex items-center gap-2">
					{i > 0 && <span aria-hidden="true">/</span>}
					{item.href ? (
						<a href={item.href} class="transition hover:text-amber">
							{item.label}
						</a>
					) : (
						<span class="text-amber" aria-current="page">
							{item.label}
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
