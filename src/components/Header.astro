---
import GlobalSearch from "./GlobalSearch.astro";

const whatsappNumber = "573116001851";
---

<header
	class="sticky top-0 z-50 w-full border-b-2 border-graphite-light bg-gradient-to-br from-graphite to-graphite-lowest px-5 py-4 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)] md:px-margin-desktop"
>
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
		<a href="/#inicio" class="flex shrink-0 items-baseline gap-1">
			<span class="font-heading text-2xl font-extrabold italic uppercase tracking-tight text-amber"
				>ELECTRO<span class="text-red">LUJOS</span></span
			>
		</a>

		<nav class="hidden shrink-0 items-center gap-8 font-mono text-xs uppercase tracking-widest text-cream-dim md:flex">
			<a href="/productos" class="transition hover:text-amber">Productos</a>
			<a href="/#ubicacion" class="transition hover:text-amber">Ubicación</a>
			<a href="/#preguntas-frecuentes" class="transition hover:text-amber">Preguntas</a>
			<a href="/#contacto" class="transition hover:text-amber">Contacto</a>
		</nav>

		<GlobalSearch class="hidden md:block md:w-56" />

		<a
			href={`https://wa.me/${whatsappNumber}`}
			target="_blank"
			rel="noopener noreferrer"
			class="chrome-bezel hidden shrink-0 items-center gap-2 bg-red px-4 py-2 font-mono text-xs font-semibold uppercase tracking-widest text-cream transition hover:bg-red-dark sm:flex"
		>
			WhatsApp
		</a>

		<button
			type="button"
			id="mobile-menu-btn"
			aria-label="Abrir menú"
			aria-expanded="false"
			class="flex items-center justify-center border border-graphite-light p-2 text-cream-dim md:hidden"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="h-5 w-5"
			>
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</div>

	<div id="mobile-menu" class="hidden md:hidden">
		<div class="mx-auto mt-4 max-w-6xl">
			<GlobalSearch />
			<nav class="mt-4 flex flex-col gap-1 font-mono text-xs uppercase tracking-widest text-cream-dim">
				<a href="/productos" class="border-b border-graphite-light/60 py-3 transition hover:text-amber">Productos</a>
				<a href="/#ubicacion" class="border-b border-graphite-light/60 py-3 transition hover:text-amber">Ubicación</a>
				<a href="/#preguntas-frecuentes" class="border-b border-graphite-light/60 py-3 transition hover:text-amber">Preguntas</a>
				<a href="/#contacto" class="border-b border-graphite-light/60 py-3 transition hover:text-amber">Contacto</a>
				<a
					href={`https://wa.me/${whatsappNumber}`}
					target="_blank"
					rel="noopener noreferrer"
					class="chrome-bezel mt-4 flex items-center justify-center gap-2 bg-red px-4 py-3 font-semibold text-cream transition hover:bg-red-dark"
				>
					WhatsApp
				</a>
			</nav>
		</div>
	</div>
</header>

<script>
	const menuBtn = document.getElementById("mobile-menu-btn");
	const menu = document.getElementById("mobile-menu");

	menuBtn?.addEventListener("click", () => {
		const isHidden = menu?.classList.toggle("hidden");
		menuBtn.setAttribute("aria-expanded", String(!isHidden));
	});
</script>
