---
const whatsappNumber = "573116001851";
const phoneDisplay = "311 600 1851";
const whatsappMessage = encodeURIComponent(
	"Hola Electrolujos, quiero más información sobre sus repuestos."
);
---

<section id="contacto" class="relative overflow-hidden border-y-2 border-graphite-light bg-graphite py-20">
	<div class="hud-scanline absolute inset-0 opacity-20"></div>

	<div class="relative mx-auto max-w-3xl px-5 text-center">
		<div class="bezel-top mx-auto inline-block pt-4">
			<h2 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
				Contáctanos
			</h2>
		</div>
		<p class="mx-auto mt-4 max-w-lg font-body text-cream-dim">
			Escríbenos por WhatsApp o llámanos para consultar disponibilidad de repuestos y accesorios.
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			<a
				href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
				target="_blank"
				rel="noopener noreferrer"
				class="chrome-bezel primary-glow flex items-center justify-center gap-3 bg-red px-6 py-5 font-heading font-bold uppercase tracking-wide text-white transition hover:bg-red-dark"
			>
				WhatsApp: {phoneDisplay}
			</a>
			<a
				href={`tel:+${whatsappNumber}`}
				class="flex items-center justify-center gap-3 border-2 border-graphite-light px-6 py-5 font-heading font-bold uppercase tracking-wide text-white transition hover:border-amber hover:text-amber"
			>
				Llamar: {phoneDisplay}
			</a>
		</div>
	</div>
</section>
