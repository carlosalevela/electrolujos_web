---
import { Image } from "astro:assets";
import localFachada from "../assets/local-fachada.jpeg";

const address = "Calle 15, Pasto, Nariño, Colombia";
const plusCode = "6P4C+HP Pasto, Nariño";
const encodedPlusCode = encodeURIComponent(plusCode);
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodedPlusCode}&z=17&output=embed`;
const mapDirectionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodedPlusCode}`;
---

<section id="ubicacion" class="bg-carbon px-5 py-20 md:px-margin-desktop">
	<div class="mx-auto max-w-6xl">
		<div class="bezel-top mb-12 pt-4">
			<h2 class="font-heading text-3xl font-extrabold uppercase italic tracking-tight text-white sm:text-4xl">
				Nuestra ubicación
			</h2>
			<div class="mt-4 h-2 w-32 bg-amber"></div>
		</div>

		<button
			type="button"
			data-photo-trigger
			aria-label="Ver foto completa del local"
			class="chrome-bezel group relative mb-8 block w-full cursor-zoom-in overflow-hidden"
		>
			<Image src={localFachada} alt="Fachada del local Electrolujos" width={1600} height={700} class="h-56 w-full object-cover transition group-hover:brightness-110 sm:h-72 md:h-80" />
			<div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/0 to-transparent"></div>
			<div class="absolute bottom-4 left-4 right-4 text-left sm:bottom-6 sm:left-6">
				<span
					class="chrome-bezel inline-block bg-amber px-3 py-1 font-mono text-xs font-semibold uppercase tracking-widest text-carbon"
				>
					Nuestro local
				</span>
				<p class="mt-2 font-heading text-2xl font-extrabold uppercase italic text-white sm:text-3xl">
					La Bodega de los <span class="text-red">Espejos</span>
				</p>
			</div>
			<span
				class="chrome-bezel absolute right-4 top-4 flex items-center gap-1.5 bg-carbon/80 px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-cream-dim opacity-0 backdrop-blur-md transition group-hover:opacity-100"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5">
					<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
				</svg>
				Ver completa
			</span>
		</button>

		<div
			data-photo-modal
			class="fixed inset-0 z-[100] hidden items-center justify-center bg-carbon/95 p-5 backdrop-blur-sm"
		>
			<button
				type="button"
				data-photo-close
				aria-label="Cerrar"
				class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center border border-graphite-light text-cream transition hover:border-red hover:text-red"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5">
					<path d="M18 6 6 18M6 6l12 12" />
				</svg>
			</button>
			<Image src={localFachada} alt="Fachada del local Electrolujos" width={1600} height={900} class="chrome-bezel max-h-[85vh] w-auto max-w-full object-contain" />
		</div>

		<script>
			const trigger = document.querySelector("[data-photo-trigger]");
			const modal = document.querySelector("[data-photo-modal]");
			const closeBtn = document.querySelector("[data-photo-close]");

			function openModal() {
				modal?.classList.remove("hidden");
				modal?.classList.add("flex");
			}

			function closeModal() {
				modal?.classList.add("hidden");
				modal?.classList.remove("flex");
			}

			trigger?.addEventListener("click", openModal);
			closeBtn?.addEventListener("click", closeModal);
			modal?.addEventListener("click", (e) => {
				if (e.target === modal) closeModal();
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") closeModal();
			});
		</script>

		<div class="grid gap-gutter md:grid-cols-2 md:items-center">
			<div class="industrial-card border border-graphite-light/60 p-8">
				<h3 class="font-heading text-xl font-bold uppercase text-white">Electrolujos</h3>
				<p class="mt-3 max-w-md font-body text-cream-dim">{address}</p>

				<div class="mt-8 flex items-start gap-3">
					<span class="mt-0.5 h-2 w-2 flex-shrink-0 rounded-full bg-amber"></span>
					<div>
						<p class="font-mono text-xs font-semibold uppercase tracking-widest text-amber">Horario</p>
						<p class="mt-1 text-cream-dim">Lunes a sábado, 8:30 a.m. – 6:00 p.m.</p>
					</div>
				</div>

				<a
					href={mapDirectionsHref}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-8 inline-block border-2 border-amber px-6 py-2.5 font-mono text-xs font-semibold uppercase tracking-widest text-amber transition hover:bg-amber/10"
				>
					Cómo llegar
				</a>
			</div>

			<div class="chrome-bezel relative overflow-hidden">
				<iframe
					title="Ubicación de Electrolujos"
					src={mapEmbedSrc}
					width="100%"
					height="360"
					style="border:0; filter: grayscale(0.3) invert(0.92) contrast(0.9);"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
				<div class="pointer-events-none absolute inset-0 border-[12px] border-graphite/40"></div>
				<div class="absolute left-4 top-4 border border-amber/30 bg-carbon/90 px-3 py-2 backdrop-blur-md">
					<span class="font-mono text-[10px] uppercase tracking-widest text-amber">Ubicación · Electrolujos</span>
				</div>
			</div>
		</div>
	</div>
</section>
