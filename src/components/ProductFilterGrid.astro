---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

interface Props {
	products: CollectionEntry<"products">[];
}

const { products } = Astro.props;
const brands = [...new Set(products.map((p) => p.data.vehicleBrand ?? p.data.brand))].sort();
---

<div class="mb-6 flex flex-col gap-4 border border-graphite-light/60 bg-graphite p-4 sm:flex-row sm:items-center sm:justify-between">
	<div class="relative w-full sm:w-48">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-cream-dim"
		>
			<circle cx="11" cy="11" r="7" />
			<path d="m21 21-4.35-4.35" />
		</svg>
		<input
			type="text"
			id="product-search"
			placeholder="Buscar..."
			class="w-full border border-graphite-light bg-carbon py-2.5 pl-9 pr-3 font-mono text-xs uppercase tracking-widest text-cream placeholder:text-cream-dim/50 focus:border-amber focus:outline-none"
		/>
	</div>
	<div class="flex flex-wrap gap-2" id="brand-filters">
		<button
			type="button"
			data-brand-filter="all"
			class="brand-filter-btn chrome-bezel bg-red px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-white"
			aria-pressed="true"
		>
			Todas
		</button>
		{
			brands.map((brand) => (
				<button
					type="button"
					data-brand-filter={brand}
					class="brand-filter-btn border border-graphite-light px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-cream-dim transition hover:border-red hover:text-white"
					aria-pressed="false"
				>
					{brand}
				</button>
			))
		}
	</div>
</div>

<p id="no-results" class="hidden py-16 text-center font-mono text-xs uppercase tracking-widest text-cream-dim">
	No se encontraron productos con ese filtro.
</p>

<div class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3" id="product-grid">
	{products.map((product, index) => <ProductCard product={product} priority={index < 3} />)}
</div>

<script>
	const searchInput = document.getElementById("product-search") as HTMLInputElement | null;
	const brandButtons = document.querySelectorAll<HTMLButtonElement>("[data-brand-filter]");
	const cards = document.querySelectorAll<HTMLElement>("[data-product-card]");
	const noResults = document.getElementById("no-results");

	let activeBrand = "all";

	function applyFilters() {
		const query = (searchInput?.value ?? "").trim().toLowerCase();
		let visibleCount = 0;

		cards.forEach((card) => {
			const name = card.dataset.name ?? "";
			const brand = card.dataset.brand ?? "";
			const matchesBrand = activeBrand === "all" || brand === activeBrand;
			const matchesQuery = query === "" || name.includes(query);
			const visible = matchesBrand && matchesQuery;
			card.style.display = visible ? "" : "none";
			if (visible) visibleCount++;
		});

		noResults?.classList.toggle("hidden", visibleCount !== 0);
	}

	searchInput?.addEventListener("input", applyFilters);

	const urlQuery = new URLSearchParams(window.location.search).get("q");
	if (urlQuery && searchInput) {
		searchInput.value = urlQuery;
		applyFilters();
		document.getElementById("product-grid")?.scrollIntoView({ behavior: "smooth", block: "start" });
	}

	brandButtons.forEach((button) => {
		button.addEventListener("click", () => {
			activeBrand = button.dataset.brandFilter ?? "all";
			brandButtons.forEach((b) => {
				const isActive = b === button;
				b.setAttribute("aria-pressed", String(isActive));
				b.classList.toggle("chrome-bezel", isActive);
				b.classList.toggle("bg-red", isActive);
				b.classList.toggle("text-white", isActive);
				b.classList.toggle("border", !isActive);
				b.classList.toggle("border-graphite-light", !isActive);
				b.classList.toggle("text-cream-dim", !isActive);
			});
			applyFilters();
		});
	});
</script>
